# =============================================================================
# TREVOR – AI SOFTWARE STUDIO & MULTI-AGENT COMMAND CENTER
# ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================

# Server Port
PORT=3000

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Cloud Database & Realtime)
# Wenn nicht gesetzt, schaltet das Studio automatisch auf den lokalen
# Datei-Fallback ('00_Checkpoints_und_Status/local_db_fallback.json') um!
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# KI-ENGINES: MODUS A (GEMINI) & MODUS B (OLLAMA)
# -----------------------------------------------------------------------------

# Modus A: Google Gemini Cloud API (ideal für Schule, mobiles Arbeiten & hohe Geschwindigkeit)
# Kostenlosen Key erstellen unter: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# Modus B: Ollama Local Engine (ideal für zu Hause, 100% lokal & offline)
# Download unter: https://ollama.ai/ -> Befehl im Terminal: ollama run llama3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Studio Theme & Verhalten
QUIET_VIEW=false
